DATABASE_URL=postgresql://user:password@localhost:5432/scholarbean
PORT=8000
NODE_ENV=development

# CORS - add your frontend URL
FRONTEND_URL=http://localhost:3000

# Auth Secrets
JWT_SECRET=scholarbean-dev-jwt-secret-key-32charsmin!
ADMIN_DEFAULT_EMAIL=admin@scholarbean.com
ADMIN_DEFAULT_PASSWORD=AdminScholarBean2026!

# For AI-powered scraping (optional - Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Scraper schedule (cron format) - default: 2am daily
SCRAPER_SCHEDULE=0 2 * * *
